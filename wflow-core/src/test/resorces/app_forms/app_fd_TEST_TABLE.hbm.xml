<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class entity-name="app_fd_TEST_TABLE" lazy="false" name="org.joget.apps.form.model.FormRow" table="app_fd_TEST_TABLE">
        <cache usage="transactional"/> 
        <id name="id" type="string"/>
        <property index="idx_datecreated" name="dateCreated" type="timestamp"/>
        <property name="dateModified" type="timestamp"/>
        <property index="idx_createdby" name="createdBy" type="string"/>
        <property name="createdByName" type="string"/>
        <property name="modifiedBy" type="string"/>
        <property name="modifiedByName" type="string"/>
        <dynamic-component insert="true" name="customProperties" optimistic-lock="true" unique="false" update="true">
            <property column="c_FIELD2" name="FIELD2" not-null="false" type="text"/>
            <property column="c_field1" name="field1" not-null="false" type="text"/>
        </dynamic-component>
    </class>
</hibernate-mapping>