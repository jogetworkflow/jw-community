<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class entity-name="PackageActivityForm" name="org.joget.apps.app.model.PackageActivityForm" table="app_package_activity_form">
        <cache usage="transactional" /> 
        <composite-id class="org.joget.apps.app.model.PackageActivityFormKey" mapped="true" unsaved-value="any">
            <key-property column="processDefId" name="processDefId" type="string"/>
            <key-property column="activityDefId" name="activityDefId" type="string"/>
            <key-property column="packageId" name="packageId" type="string"/>
            <key-property column="packageVersion" name="packageVersion" type="long"/>
        </composite-id>
        <property column="ouid" name="uid" type="string"/>
        <property name="type" type="string"/>
        <property name="formId" type="string"/>
        <property name="formUrl" type="string"/>
        <property name="formIFrameStyle" type="string"/>
        <property name="autoContinue" type="boolean"/>
        <property name="disableSaveAsDraft" type="boolean"/>
        <many-to-one entity-name="PackageDefinition" insert="false" name="packageDefinition" not-null="true" update="false" lazy="proxy">
            <column name="packageId"/>
            <column name="packageVersion"/>
        </many-to-one>
    </class>
</hibernate-mapping>
