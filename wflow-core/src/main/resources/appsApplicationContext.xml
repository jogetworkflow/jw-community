<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:p="http://www.springframework.org/schema/p"
       xmlns:aop="http://www.springframework.org/schema/aop"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
       http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop-2.5.xsd
       http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-2.5.xsd
       http://www.springframework.org/schema/tx http://www.springframework.org/schema/tx/spring-tx-2.5.xsd">

    <import resource="classpath:wfengineApplicationContext.xml" />

    <bean id="formService" class="org.joget.apps.form.service.FormServiceImpl" lazy-init="true">
    </bean>

    <bean id="appFluCache" class="org.joget.apps.app.dao.AppDefCache" lazy-init="true">
        <property name="cacheManager" ref="cacheManager" />
    </bean>

    <bean id="formColumnCache" class="org.joget.apps.form.model.FormColumnCache" lazy-init="true">
        <property name="cache" ref="longTermCache"/>
    </bean>
    
    <bean id="formOptionsCacheExecutor" class="org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler" lazy-init="true">
        <property name="poolSize" value="10" />
        <property name="waitForTasksToCompleteOnShutdown" value="false" />
    </bean>
    
    <bean id="formDataDao" class="org.joget.apps.form.dao.FormDataDaoImpl" lazy-init="true">
        <property name="formDefinitionDao" ref="formDefinitionDao" />
        <property name="builderDefinitionDao" ref="builderDefinitionDao" />
        <property name="formService" ref="formService" />
        <property name="formColumnCache" ref="formColumnCache" />
        <property name="cacheManager" ref="cacheManager" />
    </bean>
    
    <bean id="formDataSessionFactory" class="org.joget.commons.cache.InMemoryCacheSessionFactoryBean" lazy-init="true">
        <property name="dataSource" ref="setupDataSource"/>
        <property name="mappingResources">
            <list>
                <value>/org/joget/apps/form/model/FormRow.hbm.xml</value>
            </list>
        </property>
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.hbm2ddl.auto"></prop>
                <prop key="hibernate.show_sql">false</prop>
                <prop key="hibernate.format_sql">false</prop>
                <prop key="hibernate.enable_lazy_load_no_trans">true</prop>
                <prop key="hibernate.allow_update_outside_transaction">true</prop>
                <prop key="hibernate.transaction.coordinator_class">jdbc</prop>                
                <prop key="hibernate.transaction.jta.platform">org.hibernate.service.jta.platform.internal.BitronixJtaPlatform</prop>
                <prop key="hibernate.connection.release_mode">after_transaction</prop>
                <prop key="hibernate.query.plan_cache_max_size">2048</prop>
                <prop key="hibernate.query.plan_parameter_metadata_max_size">128</prop>
                <prop key="hibernate.generate_statistics">true</prop>
            </props>
        </property>
    </bean>

    <bean id="appDefinitionDao" class="org.joget.apps.app.dao.AppDefinitionDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="appSessionFactory"/>
        <property name="cache" ref="appFluCache" />
    </bean>

    <bean id="formDefinitionDao" class="org.joget.apps.app.dao.FormDefinitionDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="appSessionFactory"/>
        <property name="formColumnCache" ref="formColumnCache" />
        <property name="cache" ref="appFluCache" />
    </bean>

    <bean id="userviewDefinitionDao" class="org.joget.apps.app.dao.UserviewDefinitionDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="appSessionFactory"/>
        <property name="cache" ref="appFluCache" />
    </bean>

    <bean id="datalistDefinitionDao" class="org.joget.apps.app.dao.DatalistDefinitionDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="appSessionFactory"/>
        <property name="cache" ref="appFluCache" />
    </bean>
    
    <bean id="builderDefinitionDao" class="org.joget.apps.app.dao.BuilderDefinitionDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="appSessionFactory"/>
        <property name="cache" ref="appFluCache" />
    </bean>

    <bean id="packageDefinitionDao" class="org.joget.apps.app.dao.PackageDefinitionDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="appSessionFactory"/>
        <property name="appDefinitionDao" ref="appDefinitionDao"/>
        <property name="cache" ref="appFluCache" />
    </bean>

    <bean id="messageDao" class="org.joget.apps.app.dao.MessageDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="appSessionFactory"/>
        <property name="cache" ref="appFluCache" />
    </bean>

    <bean id="environmentVariableDao" class="org.joget.apps.app.dao.EnvironmentVariableDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="appSessionFactory"/>
    </bean>

    <bean id="pluginDefaultPropertiesDao" class="org.joget.apps.app.dao.PluginDefaultPropertiesDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="appSessionFactory"/>
        <property name="cache" ref="appFluCache" />
    </bean>
    
    <bean id="appResourceDao" class="org.joget.apps.app.dao.AppResourceDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="appSessionFactory"/>
        <property name="cache" ref="appFluCache" />
    </bean>

    <bean id="AuditTrailDao" class="org.joget.apps.app.dao.AuditTrailDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="reportSessionFactory"/>
    </bean>

    <bean id="appSessionFactory" class="org.joget.commons.cache.InMemoryCacheSessionFactoryBean" lazy-init="true">
        <qualifier value="app"/>
        <property name="dataSource" ref="setupDataSource"/>
        <property name="mappingResources">
            <list>
                <value>/org/joget/apps/app/model/AppDefinition.hbm.xml</value>
                <value>/org/joget/apps/app/model/DatalistDefinition.hbm.xml</value>
                <value>/org/joget/apps/app/model/FormDefinition.hbm.xml</value>
                <value>/org/joget/apps/app/model/PackageDefinition.hbm.xml</value>
                <value>/org/joget/apps/app/model/PackageActivityForm.hbm.xml</value>
                <value>/org/joget/apps/app/model/PackageActivityPlugin.hbm.xml</value>
                <value>/org/joget/apps/app/model/PackageParticipant.hbm.xml</value>
                <value>/org/joget/apps/app/model/UserviewDefinition.hbm.xml</value>
                <value>/org/joget/apps/app/model/BuilderDefinition.hbm.xml</value>
                <value>/org/joget/apps/app/model/PluginDefaultProperties.hbm.xml</value>
                <value>/org/joget/apps/app/model/Message.hbm.xml</value>
                <value>/org/joget/apps/app/model/AppResource.hbm.xml</value>
                <value>/org/joget/apps/app/model/EnvironmentVariable.hbm.xml</value>
                <value>/org/joget/apps/app/model/UserReplacement.hbm.xml</value>
            </list>
        </property>
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.hbm2ddl.auto">update</prop>
                <prop key="hibernate.show_sql">false</prop>
                <prop key="hibernate.format_sql">false</prop>
                <prop key="hibernate.enable_lazy_load_no_trans">true</prop>
                <prop key="hibernate.allow_update_outside_transaction">true</prop>
                <prop key="hibernate.transaction.coordinator_class">jdbc</prop>
                <prop key="hibernate.transaction.jta.platform">org.hibernate.service.jta.platform.internal.BitronixJtaPlatform</prop>
                <prop key="hibernate.connection.release_mode">after_transaction</prop>
                <prop key="hibernate.generate_statistics">true</prop>
            </props>
        </property>
    </bean>
    
    <!-- Hibernate SessionFactory for report-->
    <bean id="reportSessionFactory" class="org.joget.commons.cache.InMemoryCacheSessionFactoryBean" lazy-init="true">
        <qualifier value="report"/>
        <property name="dataSource" ref="setupDataSource"/>
        <property name="mappingResources">
            <list>
                <value>/org/joget/report/model/ReportApp.hbm.xml</value>
                <value>/org/joget/report/model/ReportWorkflowPackage.hbm.xml</value>
                <value>/org/joget/report/model/ReportWorkflowProcess.hbm.xml</value>
                <value>/org/joget/report/model/ReportWorkflowActivity.hbm.xml</value>
                <value>/org/joget/report/model/ReportWorkflowProcessInstance.hbm.xml</value>
                <value>/org/joget/report/model/ReportWorkflowActivityInstance.hbm.xml</value>
                <value>/org/joget/apps/app/model/AuditTrail.hbm.xml</value>
                <value>/org/joget/apps/form/model/FormDataAuditTrail.hbm.xml</value>
            </list>
        </property>
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.hbm2ddl.auto">update</prop>
                <prop key="hibernate.show_sql">false</prop>
                <prop key="hibernate.enable_lazy_load_no_trans">true</prop>
                <prop key="hibernate.allow_update_outside_transaction">true</prop>
                <prop key="hibernate.transaction.coordinator_class">jdbc</prop>
                <prop key="hibernate.transaction.jta.platform">org.hibernate.service.jta.platform.internal.BitronixJtaPlatform</prop>
                <prop key="hibernate.connection.release_mode">after_transaction</prop>
                <prop key="hibernate.generate_statistics">true</prop>
            </props>
        </property>
    </bean>
    
    <bean id="reportAppDao" class="org.joget.report.dao.ReportAppDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="reportSessionFactory"/>
    </bean>
    
    <bean id="reportWorkflowPackageDao" class="org.joget.report.dao.ReportWorkflowPackageDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="reportSessionFactory"/>
    </bean>
    
    <bean id="reportWorkflowProcessDao" class="org.joget.report.dao.ReportWorkflowProcessDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="reportSessionFactory"/>
    </bean>
    
    <bean id="reportWorkflowActivityDao" class="org.joget.report.dao.ReportWorkflowActivityDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="reportSessionFactory"/>
    </bean>
    
    <bean id="reportWorkflowProcessInstanceDao" class="org.joget.report.dao.ReportWorkflowProcessInstanceDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="reportSessionFactory"/>
    </bean>
    
    <bean id="reportWorkflowActivityInstanceDao" class="org.joget.report.dao.ReportWorkflowActivityInstanceDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="reportSessionFactory"/>
    </bean>
    
    <bean id="reportExecutor" class="org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor" lazy-init="true">
        <property name="maxPoolSize" value="10" />
        <property name="waitForTasksToCompleteOnShutdown" value="true" />
    </bean>
    
    <bean id="commonTaskScheduler" class="org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler" lazy-init="true">
        <property name="poolSize" value="10" />
        <property name="waitForTasksToCompleteOnShutdown" value="true" />
        <property name="removeOnCancelPolicy" value="true" />
        <property name="threadNamePrefix" value="CommonScheduler-" />
    </bean>
    
    <bean id="formDataAuditTrailDao" class="org.joget.apps.form.dao.FormDataAuditTrailDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="reportSessionFactory"/>
    </bean>
    
    <bean id="userReplacementDao" class="org.joget.apps.app.dao.UserReplacementDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="appSessionFactory"/>
    </bean>

    <bean id="workflowHelper" class="org.joget.apps.app.service.AppWorkflowHelper" lazy-init="true">
    </bean>
    
    <bean id="pluginHashVariableHelper" class="org.joget.apps.app.service.PluginHashVariableHelperImpl" lazy-init="true">
    </bean>

    <bean id="appPluginUtil" class="org.joget.apps.app.service.AppPluginUtil">
    </bean>

    <bean id="auditTrailManager" class="org.joget.apps.app.service.AuditTrailManagerImpl" lazy-init="true">
    </bean>

    <bean id="auditTrailInterceptor" class="org.joget.apps.app.service.AuditTrailInterceptor" lazy-init="true">
    </bean>
    
    <bean id="sqlFilterAspect" class="org.joget.apps.app.service.SqlFilterAspect" lazy-init="true">
    </bean>
   
    <bean id="pushService" class="org.joget.apps.app.service.PushServiceUtil">
        <property name="publicKey" value="BE54-RlSdVqGwlh_skZ4qQqP1tY7uNZrQbv3IJ_Rd2uRHsId8XjvH2CXav_5PkhrM1XvBLXJyi7tx6io5E3fegg"/>
        <property name="privateKey" value="Fe0bTj0H_UYcg7qnFzx0qBl-H90RuptO6r_vOUZJWvI"/>
    </bean>
    
    <!-- Important: this is to let the XPath object created before Security Manageger initialized -->
    <bean id="dependenciesService" class="org.joget.apps.app.service.DependenciesUtil">
    </bean>

    <bean
        class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetClass"
            value="org.springframework.security.core.context.SecurityContextHolder" />
        <property name="targetMethod" value="setStrategyName" />
        <property name="arguments" value="org.joget.apps.util.ThreadLocalSecurityContextHolderStrategy" />
    </bean>
            
    <bean id="setupManagerHelper" class="org.joget.apps.app.service.AppSetupManagerHelperImpl" lazy-init="true">
    </bean>
    
    <bean id="govHealthCheckScheduler" class="org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler" lazy-init="true">
        <property name="poolSize" value="10" />
        <property name="waitForTasksToCompleteOnShutdown" value="false" />
    </bean>
    
    <bean id="govHealthCheckManager" class="org.joget.governance.service.GovHealthCheckManager" depends-on="govHealthCheckScheduler, setupManager" lazy-init="true">
        <constructor-arg><ref bean="govHealthCheckScheduler" /></constructor-arg>
        <constructor-arg><ref bean="setupManager" /></constructor-arg>
    </bean>

    <bean id="userAuthenticationService" class="org.joget.apps.util.UserAuthenticationService" lazy-init="true"/>
   
    <aop:config>
        <aop:advisor advice-ref="txAdvice" pointcut="execution(* org.joget.apps.app.dao.*Dao.*(..)) and !(execution(* org.joget.apps.app.dao.AppDefinitionDao.updateDateModified(..)))" order="1" />
        <aop:advisor advice-ref="txAdvice" pointcut="execution(* org.joget.report.dao.*Dao.*(..))" order="1" />
        <aop:advisor advice-ref="txAdvice" pointcut="execution(* org.joget.apps.form.dao.*Dao.*(..))" order="1" />
        <aop:advisor advice-ref="sqlFilterAspect" pointcut="execution(* org.joget.workflow.model.service.WorkflowManager.*(..))" order="1" />
        <aop:advisor advice-ref="auditTrailInterceptor" pointcut="execution(* org.joget.workflow.model.service.WorkflowManager.*(..)) and !(execution(* org.joget..*.get*(..)) or execution(* org.joget..*.set*(..)) or execution(* org.joget..*.is*(..)) or execution(* org.joget..*.internal*(..) or execution(* org.joget..*.*Inbox*(..)))" order="2" />
        <aop:advisor advice-ref="auditTrailInterceptor" pointcut="execution(* org.joget.directory.dao.*Dao.*(..)) and !(execution(* org.joget..*.get*(..)) or execution(* org.joget..*.set*(..)))" order="1" />
        <aop:advisor advice-ref="auditTrailInterceptor" pointcut="execution(* org.joget.apps.form.dao.FormDataDao.*(..)) and !(execution(* org.joget..*.get*(..)) or execution(* org.joget..*.set*(..)) or execution(* org.joget..*.internal*(..)) or execution(* org.joget..*.loadByTable*(..)) or execution(* org.joget..*.clear*(..)))" order="1" />
        <aop:advisor advice-ref="auditTrailInterceptor" pointcut="execution(* org.joget.apps.app.dao.*Dao.*(..)) and !(execution(* org.joget.apps.app.dao.AuditTrailDao.*(..))) and (execution(* org.joget..*.save*(..)) or execution(* org.joget..*.delete*(..)) or execution(* org.joget..*.add*(..)) or execution(* org.joget..*.update*(..)))" order="1" />
    </aop:config>

</beans>