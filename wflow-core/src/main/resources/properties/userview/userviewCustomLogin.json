{
    "name" : "customLogin",
    "label" : "@@userview.customLogin.customLoginMessage@@",
    "type" : "checkbox",
    "options" : [
        {
            "value" : "true",
            "label" : ""
        }
    ]
},
{
    "name" : "template",
    "label" : "@@userview.customLogin.chooseLoginTemplate@@",
    "type" : "custom",
    "script_url" : "[CONTEXT_PATH]/web/console/app[APP_PATH]/userview/loginTemplateEditor?version=@@build.number@@",
    "mode" : "html",
    "required" : "true",
    "control_field": "customLogin",
    "control_value": "true",
    "tags" : [
        {"value" : "card", "label" : "@@userview.customLogin.card@@"},
        {"value" : "icon", "label": "@@userview.customLogin.icon@@"},
        {"value" : "image", "label": "@@userview.customLogin.image@@"},
        {"value" : "title", "label": "@@userview.customLogin.title@@"},
        {"value" : "simple", "label": "@@userview.customLogin.tag.simple@@"},
        {"value" : "subtitle", "label": "@@userview.customLogin.subtitle@@"}
    ]
},
{
    "name" : "title",
    "label" : "@@userview.customLogin.title@@",
    "type" : "textfield",
    "control_field": "template",
    "control_value": "^[\\s\\S]*\\{\\{title[\\||\\}]{2}[\\s\\S]*$",
    "control_use_regex": "true",
    "required" : "true"
},
{
    "name" : "titleColor",
    "label" : "@@userview.customLogin.titleColor@@",
    "type" : "color",
    "control_field": "template",
    "control_value": "^[\\s\\S]*\\{\\{titleColor[\\||\\}]{2}[\\s\\S]*$",
    "control_use_regex": "true",
    "required" : "true"
},
{
    "name" : "formColor",
    "label" : "@@userview.customLogin.formColor@@",
    "type" : "color",
    "control_field": "template",
    "control_value": "^[\\s\\S]*\\{\\{formColor[\\||\\}]{2}[\\s\\S]*$",
    "control_use_regex": "true"
},
{
    "name" : "customUsername",
    "label" : "@@userview.customLogin.usernameText@@",
