    "control_field": "template",
    "control_value": "^[\\s\\S]*\\{\\{customUsername[\\||\\}]{2}[\\s\\S]*$",
    "control_use_regex": "true"
},
{
    "name" : "customUsernameColor",
    "label" : "@@userview.customLogin.usernameColor@@",
    "type" : "color",
    "control_field": "template",
    "control_value": "^[\\s\\S]*\\{\\{customUsernameColor[\\||\\}]{2}[\\s\\S]*$",
    "control_use_regex": "true"
},
{
    "name" : "customPassword",
    "label" : "@@userview.customLogin.passwordText@@",
