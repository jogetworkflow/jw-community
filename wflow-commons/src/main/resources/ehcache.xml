<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3">

    <!-- Default Cache configuration equivalent in Ehcache 3.x -->
    <cache alias="default">
        <expiry>
            <ttl unit="seconds">120</ttl>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
            <!-- No overflow to disk -->
        </resources>
        <!-- Disk persistence is not enabled -->
    </cache>

    <!-- Cache for org.joget.cache.SETUP_CACHE -->
    <cache alias="org.joget.cache.SETUP_CACHE">
        <expiry>
            <ttl unit="seconds">20</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for org.joget.cache.LONG_TERM_SETUP_CACHE (Eternal). Used by SetupManagerCache. -->
    <cache alias="org.joget.cache.LONG_TERM_SETUP_CACHE">
        <expiry>
            <none/>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for org.joget.cache.DATASOURCE_CACHE -->
    <cache alias="org.joget.cache.DATASOURCE_CACHE">
        <expiry>
            <ttl unit="seconds">20</ttl>
        </expiry>
        <listeners>
            <listener>
                <class>org.joget.commons.util.SessionFactoryCacheListener</class>
                <event-firing-mode>ASYNCHRONOUS</event-firing-mode>
                <event-ordering-mode>UNORDERED</event-ordering-mode>
                <events-to-fire-on>EXPIRED</events-to-fire-on>
                <events-to-fire-on>EVICTED</events-to-fire-on>
                <events-to-fire-on>REMOVED</events-to-fire-on>
            </listener>
        </listeners>
        <resources>
            <heap unit="entries">1000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for org.joget.cache.RBM_CACHE (Eternal) -->
    <cache alias="org.joget.cache.RBM_CACHE">
        <expiry>
            <none/>
        </expiry>
        <resources>
            <heap unit="entries">50000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for org.joget.cache.SF_CACHE with event listener -->
    <cache alias="org.joget.cache.SF_CACHE">
        <expiry>
            <none/>
        </expiry>
        <listeners>
            <listener>
                <class>org.joget.commons.util.SessionFactoryCacheListener</class>
                <event-firing-mode>ASYNCHRONOUS</event-firing-mode>
                <event-ordering-mode>UNORDERED</event-ordering-mode>
                <events-to-fire-on>EXPIRED</events-to-fire-on>
                <events-to-fire-on>EVICTED</events-to-fire-on>
                <events-to-fire-on>REMOVED</events-to-fire-on>
            </listener>
        </listeners>
        <resources>
            <heap unit="entries">5000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for form, list, userview (org.joget.cache.FLU_CACHE) -->
    <cache alias="org.joget.cache.FLU_CACHE">
        <expiry>
            <none/>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for UserviewMenu content (org.joget.cache.USERVIEW_CACHE) -->
    <cache alias="org.joget.cache.USERVIEW_CACHE">
        <expiry>
            <class>org.joget.commons.util.DynamicExpiryPolicy</class>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <!-- No overflow to disk -->
        </resources>
        <!--<searchable/>-->
    </cache>

    <!-- Cache for form options (org.joget.cache.FORM_OPTIONS_CACHE) -->
    <cache alias="org.joget.cache.FORM_OPTIONS_CACHE">
        <expiry>
            <class>org.joget.commons.util.DynamicExpiryPolicy</class>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <!-- No overflow to disk -->
        </resources>
        <!--<searchable/>-->
    </cache>
                
    <cache alias="org.joget.cache.APP_CACHE">
        <expiry>
            <ttl unit="seconds">20</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <!-- No overflow to disk -->
        </resources>
        <!--<searchable/>-->
    </cache>

    <!-- Cache for LESS (org.joget.cache.CSS_CACHE) -->
    <cache alias="org.joget.cache.CSS_CACHE">
        <expiry>
            <ttl unit="seconds">600</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for session nonce (org.joget.cache.NONCE_CACHE) -->
    <cache alias="org.joget.cache.NONCE_CACHE">
        <expiry>
            <class>org.joget.commons.util.DynamicExpiryPolicy</class>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for MFA nonce (org.joget.cache.MFA_NONCE) -->
    <cache alias="org.joget.cache.MFA_NONCE">
        <expiry>
            <ttl unit="seconds">600</ttl>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for identity provider (org.joget.cache.IDENTITY_PROVIDER) -->
    <cache alias="org.joget.cache.IDENTITY_PROVIDER">
        <expiry>
            <ttl unit="seconds">3600</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for Row Count -->
    <cache alias="org.joget.cache.ROW_COUNT_CACHE">
        <expiry>
            <class>org.joget.commons.util.DynamicExpiryPolicy</class>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for Beanshell Transformer -->
    <cache alias="org.joget.cache.BEANSHELL_TRANSFORMER_CACHE">
        <expiry>
            <ttl unit="seconds">600</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

    <!-- Cache for Default Property Values -->
    <cache alias="org.joget.cache.DEFAULT_PROPERTY_VALUES_CACHE">
        <expiry>
            <ttl unit="seconds">3600</ttl>
        </expiry>
        <resources>
            <heap unit="entries">1000</heap>
            <!-- No overflow to disk -->
        </resources>
    </cache>

</config>
