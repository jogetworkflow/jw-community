<?xml version="1.0" encoding="windows-1252"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:p="http://www.springframework.org/schema/p"
       xmlns:aop="http://www.springframework.org/schema/aop"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
       http://www.springframework.org/schema/aop http://www.springframework.org/schema/aop/spring-aop-2.5.xsd
       http://www.springframework.org/schema/tx http://www.springframework.org/schema/tx/spring-tx-2.5.xsd
              http://www.springframework.org/schema/context
       http://www.springframework.org/schema/context/spring-context-2.5.xsd">

    <aop:config>
        <aop:advisor advice-ref="txAdvice" pointcut="execution(* org.joget.workflow.model.service.WorkflowManager.*(..))"/>
        <aop:advisor advice-ref="txAdvice" pointcut="execution(* org.joget.workflow.shark.model.dao.*Dao.*(..))" order="1" />
    </aop:config>
        
    <bean id="deadlineThreadManager" class="org.joget.workflow.shark.SharkDeadlineThreadManager" lazy-init="true">
    </bean>
    
    <!-- #2261 follow-up: was lazy-init="true". WorkflowManagerImpl.setSetupManager(..) (called by
         Spring as this bean's own property injection, below) re-invokes
         DeadlineThreadManager.initThreads(this) -> SharkDeadlineThreadManager.init(..), which
         iterates every tenant profile switching into each (HostManager.setCurrentProfile) to run
         initChecker()-equivalent per-tenant work. Lazy init meant that switch-into-every-tenant
         loop ran on whatever thread first touched this bean, and previously, a bare whitelist
         entry unconditionally exempted it regardless of who that caller was (removed in
         MultiTenantSecurityManager; see that class's own comment on why: the same public-setter-
         reachable cross-tenant primitive already closed for GovHealthCheckManager). With the
         whitelist entry gone, a restricted caller whose first-ever touch of this bean happened
         to land here would now see the SAME first-touch problem GovHealthCheckManager already had:
         one caller's own tenant switch, refused mid-construction. Made eager for the identical
         reason as govHealthCheckManager above: construction now happens during ApplicationContext
         refresh, before any request/plugin context (and therefore any restriction) exists.
         SharkDeadlineThreadManager.init(..)'s own per-profile try/catch/finally (added alongside
         this) also means one unreachable tenant database at boot no longer aborts every other
         tenant's initialization, let alone the whole context refresh. -->
    <bean id="workflowManager" class="org.joget.workflow.model.service.WorkflowManagerImpl">
        <constructor-arg><ref bean="setupDataSource" /></constructor-arg>
        <constructor-arg><ref bean="transactionManager" /></constructor-arg>
        <property name="workflowUserManager" ref="workflowUserManager"/>
        <property name="workflowAssignmentDao" ref="workflowAssignmentDao"/>
        <property name="setupManager" ref="setupManager"/>
        <property name="workflowProcessLinkDao" ref="workflowProcessLinkDao"/>
    </bean>

    <!-- Hibernate SessionFactory -->
    <bean id="workflowSessionFactory" class="org.joget.commons.cache.InMemoryCacheSessionFactoryBean" lazy-init="true">
        <qualifier value="workflow"/>
        <property name="dataSource" ref="setupDataSource"/>
        <property name="mappingResources">
            <list>
                <value>/org/joget/workflow/model/WorkflowProcessLink.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/SharkAssignment.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/SharkActivity.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/SharkProcess.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/SharkActivityState.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/SharkProcessState.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/ActivityPersistenceObject.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/DeadlinePersistenceObject.hbm.xml</value>
                <value>/org/joget/workflow/shark/migrate/model/MigrateActivity.hbm.xml</value>
                <value>/org/joget/workflow/shark/migrate/model/MigrateAssignment.hbm.xml</value>
                <value>/org/joget/workflow/shark/migrate/model/MigrateProcess.hbm.xml</value>
                <value>/org/joget/workflow/shark/migrate/model/MigrateProcessDefinition.hbm.xml</value>
                <value>/org/joget/workflow/model/WorkflowProcessLinkHistory.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/SharkActivityHistory.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/SharkProcessHistory.hbm.xml</value>
            </list>
        </property>
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.hbm2ddl.auto">none</prop>
                <prop key="hibernate.show_sql">false</prop>
                <prop key="hibernate.enable_lazy_load_no_trans">true</prop>
                <prop key="hibernate.allow_update_outside_transaction">true</prop>
                <prop key="hibernate.transaction.coordinator_class">jdbc</prop>
                <prop key="hibernate.transaction.jta.platform">org.hibernate.service.jta.platform.internal.BitronixJtaPlatform</prop>
                <prop key="hibernate.connection.release_mode">after_transaction</prop>
                <prop key="hibernate.query.plan_cache_max_size">2048</prop>
                <prop key="hibernate.query.plan_parameter_metadata_max_size">128</prop>
                <prop key="hibernate.generate_statistics">true</prop>
            </props>
        </property>
    </bean> 
    
    <!-- Hibernate SessionFactory added redundantly to create index & schema -->
    <bean id="sharkWorkflowUpdateSessionFactory" class="org.joget.commons.cache.InMemoryCacheSessionFactoryBean" lazy-init="true">
        <qualifier value="workflow"/>
        <property name="dataSource" ref="setupDataSource"/>
        <property name="mappingResources">
            <list>
                <value>/org/joget/workflow/model/WorkflowProcessLink.hbm.xml</value>
                <value>/org/joget/workflow/model/WorkflowProcessLinkHistory.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/SharkActivityHistory.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/SharkProcessHistory.hbm.xml</value>
            </list>
        </property>
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.hbm2ddl.auto">update</prop>
                <!-- #2253: migrate only the tables being migrated, not the whole catalog.
                     See FormDataDaoImpl.HBM2DDL_JDBC_METADATA_EXTRACTION_STRATEGY. -->
                <prop key="hibernate.hbm2ddl.jdbc_metadata_extraction_strategy">individually</prop>
                <prop key="hibernate.show_sql">false</prop>
                <prop key="hibernate.enable_lazy_load_no_trans">true</prop>
                <prop key="hibernate.allow_update_outside_transaction">true</prop>
                <prop key="hibernate.transaction.coordinator_class">jdbc</prop>
                <prop key="hibernate.transaction.jta.platform">org.hibernate.service.jta.platform.internal.BitronixJtaPlatform</prop>
                <prop key="hibernate.connection.release_mode">after_transaction</prop>
                <prop key="hibernate.query.plan_cache_max_size">16</prop>
                <prop key="hibernate.query.plan_parameter_metadata_max_size">128</prop>
            </props>
        </property>
    </bean>
    
    <bean id="sharkIdSessionFactory" class="org.joget.commons.cache.InMemoryCacheSessionFactoryBean" lazy-init="true">
        <qualifier value="sharkId"/>
        <property name="dataSource" ref="setupDataSource"/>
        <property name="mappingResources">
            <list>
                <value>/org/joget/workflow/shark/model/SharkObjectId.hbm.xml</value>
                <value>/org/joget/workflow/shark/model/SharkCounter.hbm.xml</value>
            </list>
        </property>
        <property name="hibernateProperties">
            <props>
                <prop key="hibernate.hbm2ddl.auto">none</prop>
                <prop key="hibernate.show_sql">false</prop>
                <prop key="hibernate.enable_lazy_load_no_trans">true</prop>
                <prop key="hibernate.allow_update_outside_transaction">true</prop>
                <prop key="hibernate.transaction.coordinator_class">jdbc</prop>
                <prop key="hibernate.transaction.jta.platform">org.hibernate.service.jta.platform.internal.BitronixJtaPlatform</prop>
                <prop key="hibernate.connection.release_mode">after_transaction</prop>
                <prop key="hibernate.query.plan_cache_max_size">2048</prop>
                <prop key="hibernate.query.plan_parameter_metadata_max_size">128</prop>
                <prop key="hibernate.generate_statistics">true</prop>
            </props>
        </property>
    </bean>

    <bean id="workflowAssignmentDao" class="org.joget.workflow.shark.model.dao.SharkWorkflowAssignmentDaoImpl" lazy-init="true">
        <property name="sessionFactory" ref="workflowSessionFactory"/>
        <property name="workflowProcessLinkDao" ref="workflowProcessLinkDao"/>
    </bean>
    
    <!-- Eager, like the two DAOs below: DeadlineDao has no interface and is matched by the shark DAO
         transaction advisor, so Spring builds it as a CGLIB proxy, and building the proxy class calls
         setAccessible. While the bean was lazy, a tenant script that was the first caller after a
         restart (getBean, WorkflowManager.internalCheckDeadlines, activity migration) had that call
         refused, and Spring's CGLIB class cache keeps the failed build, so later getBean callers kept
         failing too. Built at context refresh instead; its only dependency, workflowSessionFactory,
         is already built at boot. Matches 8.2. -->
    <bean id="deadlineDao" class="org.joget.workflow.shark.model.dao.DeadlineDao">
        <property name="sessionFactory" ref="workflowSessionFactory"/>
    </bean>

    <!-- Eager so the sharkIdSessionFactory (the ID-allocation path) is built during context refresh
         on the clean startup stack, not lazily on a tenant's first BeanShell-initiated process start:
         with a bsh frame on the stack, the reflection its Hibernate/JAXB mapping bootstrap does is
         refused on any JDK (and on JDK <= 17 the refused log/lambda path can also wedge a lambda call
         site). Matches 8.2, which never made these lazy. hbm2ddl.auto=none, so no eager DDL. -->
    <bean id="sharkObjectIdDao" class="org.joget.workflow.shark.model.dao.SharkObjectIdDao">
        <property name="sessionFactory" ref="sharkIdSessionFactory"/>
    </bean>

    <bean id="sharkCounterDao" class="org.joget.workflow.shark.model.dao.SharkCounterDao">
        <property name="sessionFactory" ref="sharkIdSessionFactory"/>
    </bean>
</beans>
